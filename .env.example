# ========================================
# AI PM Sandbox 环境变量示例
# 复制本文件为 .env 后填入你的配置
# ========================================

# 服务监听配置（可选，默认如下）
PORT=4173
HOST=127.0.0.1

# ---------- 企业微信 / 微信群机器人 ----------
# 在群里添加「群机器人」后，把 Webhook URL 粘贴到这里
WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=你的key

# ---------- 飞书 / Lark 自定义机器人 ----------
# 群设置 → 添加机器人 → 自定义机器人，获取 Webhook
# 如果开启了「签名校验」，再填 SECRET
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/你的hook
FEISHU_BOT_SECRET=可选-签名密钥

# ---------- Telegram Bot ----------
# 1. 找 @BotFather 新建 Bot 拿到 Token
# 2. 把 Bot 拉进群，发一条消息，访问 https://api.telegram.org/bot<token>/getUpdates 拿 chat_id
TELEGRAM_BOT_TOKEN=123456:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=-1001234567890

# ---------- TF / 通用 Webhook ----------
# 支持任意能收 POST JSON 的 endpoint
# mode: generic（默认，纯JSON）或 teams（Microsoft Teams Adaptive Card）
TF_WEBHOOK_URL=https://你的-webhook-url
TF_WEBHOOK_MODE=generic
